# Custom 404 page (the /pt/ folder has its own .htaccess pointing to the PT 404)
ErrorDocument 404 /404.html

# Don't expose directory listings (e.g. /images/, /icons/)
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # http -> https is handled by Hostinger's CDN already. Don't add a
  # %{HTTPS} rule here: behind the CDN it can see "off" and loop.

  # One host only: www.samamatahir.com -> samamatahir.com
  RewriteCond %{HTTP_HOST} ^www\.samamatahir\.com$ [NC]
  RewriteRule ^(.*)$ https://samamatahir.com/$1 [L,R=301]

  # /index.html and /folder/index.html -> the clean folder URL. THE_REQUEST
  # only matches what the visitor typed, so the server's own internal
  # DirectoryIndex lookup doesn't loop.
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
  RewriteRule ^(.*/)?index\.html$ /$1 [L,R=301,NC]
</IfModule>

# Old WordPress URLs (the previous site) -> closest page on this site
Redirect 301 /our-blog/ /
Redirect 301 /blog/ /
Redirect 301 /how-we-built-a-dynamic-add-to-cart-button-on-shopify-with-code-demo-links/ /work/
Redirect 301 /wp-bakery-meets-shopify-checkout-extensibility-a-new-era-of-customization/ /work/
Redirect 301 /how-to-display-related-products-posts-using-jetengine-query-builder-crocoblock/ /services/web-development/
Redirect 301 /maximize-performance-with-image-optimization-in-wordpress/ /services/web-development/
Redirect 301 /unlock-the-power-of-elementor-ai-for-smarter-website-design/ /services/web-development/
Redirect 301 /streamline-discussions-with-elementors-new-comment-feature/ /services/web-development/
Redirect 301 /how-to-connect-shipstation-with-wordpress-and-fix-the-502-bad-gateway-error/ /services/web-development/
Redirect 301 /auto-add-free-products-to-shopify-cart/ /work/
Redirect 301 /understanding-shopify-customer-accounts-what-changed-in-the-new-architecture/ /work/
Redirect 301 /mobile-friendly-multi-level-wordpress-menu-with-custom-walker-and-jquery/ /services/web-development/
# Old WordPress tag and category archives were all WordPress/Shopify dev topics
RedirectMatch 301 ^/(category|tag)/.* /services/web-development/
RedirectMatch 301 ^/author/.* /about/
RedirectMatch 301 ^/feed/?$ /
# Add more old URLs here as they show up in Search Console (Pages -> Not found):
# Redirect 301 /old-path/ /new-path/

# Working folders that aren't part of the site, in case they get uploaded
RedirectMatch 404 ^/(img_for_website|videos)(/|$)
RedirectMatch 404 /\.git(/|$)

# Compress text files
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json image/svg+xml text/xml application/xml text/plain application/manifest+json
</IfModule>

<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType application/manifest+json .webmanifest
</IfModule>

# Browser caching. CSS and JS are safe to cache for a long time because
# every page links them with a ?v= version that changes on each update.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 week"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/xml "access plus 1 day"
  ExpiresByType text/xml "access plus 1 day"
</IfModule>

<IfModule mod_headers.c>
  # Versioned assets: cache for a year (the CDN otherwise caps JS at 7 days)
  <FilesMatch "\.(css|js|woff2|webp|jpg|jpeg|png|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Crawler files change rarely but must update quickly when they do, so
  # cache them for an hour, not the week the CDN applies to plain text.
  <FilesMatch "^(robots\.txt|llms\.txt|sitemap\.xml)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>

  # Security headers
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set Permissions-Policy "accelerometer=(), ambient-light-sensor=(), autoplay=(self \"https://www.youtube-nocookie.com\"), bluetooth=(), browsing-topics=(), camera=(), display-capture=(), encrypted-media=(self \"https://www.youtube-nocookie.com\"), fullscreen=(self \"https://www.youtube-nocookie.com\"), geolocation=(), gyroscope=(), hid=(), idle-detection=(), magnetometer=(), microphone=(), midi=(), payment=(), picture-in-picture=(self \"https://www.youtube-nocookie.com\"), publickey-credentials-get=(), screen-wake-lock=(), serial=(), usb=(), xr-spatial-tracking=()"
  Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"

  # Content Security Policy (enforced). It ran in report-only mode first with
  # no violations. If you add a new third-party tool (script, iframe, form
  # endpoint), add its domain to the matching directive or it will be blocked.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.clarity.ms https://*.clarity.ms; connect-src 'self' https://api.web3forms.com https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com https://www.google.com https://*.doubleclick.net https://*.clarity.ms https://c.bing.com; img-src 'self' data: https://i.ytimg.com https://*.google-analytics.com https://www.googletagmanager.com https://www.google.com https://*.doubleclick.net https://*.clarity.ms https://c.bing.com; style-src 'self' 'unsafe-inline'; font-src 'self'; frame-src https://www.youtube-nocookie.com; form-action 'self' https://api.web3forms.com; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
</IfModule>
